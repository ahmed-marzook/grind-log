---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import {
  buildCalendarDays,
  formatDayTooltip,
  levelForMinutes,
  padCalendarDaysForGrid,
} from '../lib/calendar.js';
import { getBestCurrentStreak, resolveTodayStatus } from '../lib/dashboard.js';
import { summarizeGoalsByStatus } from '../lib/goals.js';
import { getAllPersons } from '../lib/people.js';
import type { Goal, LogEntry } from '../lib/streaks.js';

const logCollection = await getCollection('logs');
const goalCollection = await getCollection('goals');

const entries: LogEntry[] = logCollection.map((l) => l.data);
const goals: Goal[] = goalCollection.map((g) => g.data);

const persons = getAllPersons(entries, goals);
const today = new Date();
const base = import.meta.env.BASE_URL;

// A card-sized peek, not the full calendar — just enough weeks to show
// the shape of recent activity at a glance.
const MINI_CALENDAR_WINDOW_DAYS = 28;

const TODAY_STATUS = {
  completed: { label: 'Completed today', icon: '✅' },
  excused: { label: 'Excused today', icon: '🌙' },
  missed: { label: 'Missed today', icon: '❌' },
  'not-scheduled': { label: 'Nothing scheduled today', icon: '⚪' },
} as const;

const cards = persons.map((person) => {
  const todayStatus = resolveTodayStatus(person, entries, goals, today);
  const streak = getBestCurrentStreak(person, entries, goals, today);
  const personGoals = goals.filter((g) => g.person === person);

  let miniCalendar: ReturnType<typeof padCalendarDaysForGrid> = [];
  if (streak) {
    const from = new Date(today);
    from.setUTCDate(from.getUTCDate() - (MINI_CALENDAR_WINDOW_DAYS - 1));
    const days = buildCalendarDays(entries, goals, person, streak.topic, { from, to: today });
    miniCalendar = padCalendarDaysForGrid(days);
  }

  return {
    person,
    todayStatus,
    streak,
    goalsSummary: summarizeGoalsByStatus(personGoals),
    miniCalendar,
  };
});
---

<Base title="Dashboard">
  <h1>Study Log</h1>
  {
    cards.length === 0 ? (
      <p>No one has started logging yet.</p>
    ) : (
      <ul class="card-grid">
        {cards.map(({ person, todayStatus, streak, goalsSummary, miniCalendar }) => (
          <li>
            <a class={`person-card person-card--${todayStatus}`} href={`${base}${person}/`}>
              <div class="card-top">
                <h2>{person}</h2>
                <span class="today-badge">
                  <span aria-hidden="true">{TODAY_STATUS[todayStatus].icon}</span>{' '}
                  {TODAY_STATUS[todayStatus].label}
                </span>
              </div>
              <p class="card-streak">
                {streak ? (
                  <>
                    <span aria-hidden="true">🔥</span> <strong>{streak.current}</strong> day streak
                    · {streak.topic}
                  </>
                ) : (
                  'No entries yet'
                )}
              </p>
              {miniCalendar.length > 0 && (
                <div class="mini-calendar" role="img" aria-label={`Recent ${streak?.topic} activity`}>
                  {miniCalendar.map((day) =>
                    day === null ? (
                      <span class="mini-day mini-day--empty" />
                    ) : (
                      <span
                        class={`mini-day mini-day--${day.state}`}
                        data-level={day.state === 'completed' ? levelForMinutes(day.minutes) : undefined}
                        title={formatDayTooltip(day)}
                      />
                    )
                  )}
                </div>
              )}
              <p class="card-goals">
                <span aria-hidden="true">🎯</span> {goalsSummary}
              </p>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Base>

<style>
  .card-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
  }
  .person-card {
    display: block;
    height: 100%;
    border: 1px solid var(--border);
    border-left: 4px solid var(--not-scheduled);
    border-radius: 8px;
    padding: 1rem;
    color: var(--text);
  }
  .person-card:hover {
    text-decoration: none;
    border-color: var(--accent);
  }
  .person-card--completed {
    border-left-color: #26a641;
  }
  .person-card--excused {
    border-left-color: var(--excused);
  }
  .person-card--missed {
    border-left-color: var(--missed-border);
  }
  .card-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .card-top h2 {
    margin: 0;
    font-size: 1.1rem;
  }
  .today-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    color: var(--text-dim);
    white-space: nowrap;
  }
  .card-streak {
    margin: 0.75rem 0;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .mini-calendar {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(7, 1fr);
    gap: 2px;
    margin: 0.75rem 0;
    width: fit-content;
  }
  .mini-day {
    width: 9px;
    height: 9px;
    border-radius: 2px;
    box-sizing: border-box;
  }
  .mini-day--empty {
    visibility: hidden;
  }
  .mini-day--not-scheduled {
    background: var(--not-scheduled);
  }
  .mini-day--missed {
    background: transparent;
    border: 1px solid var(--missed-border);
  }
  .mini-day--excused {
    background: var(--excused);
  }
  .mini-day--completed[data-level='1'] {
    background: #0e4429;
  }
  .mini-day--completed[data-level='2'] {
    background: #006d32;
  }
  .mini-day--completed[data-level='3'] {
    background: #26a641;
  }
  .mini-day--completed[data-level='4'] {
    background: #39d353;
  }
  .card-goals {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    color: var(--text-dim);
    font-size: 0.85rem;
  }
</style>
