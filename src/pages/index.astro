---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const logs = await getCollection('logs');
const sorted = [...logs].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const base = import.meta.env.BASE_URL;
---

<Base title="Feed">
  <h1>Study Log</h1>
  <ul class="feed">
    {
      sorted.map((entry) => (
        <li class={`entry entry--${entry.data.status}`}>
          <div class="entry-meta">
            <a href={`${base}${entry.data.person}/calendar`}>{entry.data.person}</a>
            <time>{entry.data.date.toISOString().slice(0, 10)}</time>
          </div>
          {entry.data.status === 'completed' ? (
            <>
              <h2>{entry.data.title}</h2>
              <p class="entry-topic">
                {entry.data.topic} · {entry.data.minutes} min
              </p>
            </>
          ) : (
            <p class="entry-excused">Excused — {entry.data.reason}</p>
          )}
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .feed {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .entry {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem;
  }
  .entry-meta {
    display: flex;
    justify-content: space-between;
    color: var(--text-dim);
    font-size: 0.85rem;
    margin-bottom: 0.5rem;
  }
  .entry h2 {
    margin: 0 0 0.25rem;
    font-size: 1.05rem;
  }
  .entry-topic {
    margin: 0;
    color: var(--text-dim);
    font-size: 0.9rem;
  }
  .entry-excused {
    margin: 0;
    color: var(--excused);
    font-style: italic;
  }
</style>
