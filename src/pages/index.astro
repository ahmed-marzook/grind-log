---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import {
  buildCalendarDays,
  consistencyForWindow,
  formatDayTooltip,
  levelForMinutes,
  padCalendarDaysForGrid,
} from '../lib/calendar.js';
import {
  buildRecentActivity,
  computeOverview,
  getBestCurrentStreak,
  getMostRecentEntry,
  resolveTodayStatus,
} from '../lib/dashboard.js';
import { formatRelativeDay } from '../lib/format.js';
import { personLogsUrl, REPO_URL } from '../lib/github.js';
import { summarizeGoalsByStatus } from '../lib/goals.js';
import { getAllPersons } from '../lib/people.js';
import type { Goal, LogEntry } from '../lib/streaks.js';

const logCollection = await getCollection('logs');
const goalCollection = await getCollection('goals');

const entries: LogEntry[] = logCollection.map((l) => l.data);
const goals: Goal[] = goalCollection.map((g) => g.data);

const persons = getAllPersons(entries, goals);
const today = new Date();
const base = import.meta.env.BASE_URL;

const overview = computeOverview(persons, entries, goals, today);
const RECENT_ACTIVITY_LIMIT = 8;
const recentActivity = buildRecentActivity(entries, RECENT_ACTIVITY_LIMIT, today);

// `idea` goals are a future wishlist, not an active goal — they stay off
// the home page (only the per-person goals page shows them).
const goalsByPerson = persons.map((person) => ({
  person,
  personGoals: goals.filter((g) => g.person === person && g.status !== 'idea'),
}));

// A card-sized peek, not the full calendar — just enough weeks to show
// the shape of recent activity at a glance.
const MINI_CALENDAR_WINDOW_DAYS = 28;

const TODAY_STATUS = {
  completed: { label: 'Completed today', icon: 'lucide:circle-check' },
  excused: { label: 'Excused today', icon: 'lucide:moon' },
  missed: { label: 'Missed today', icon: 'lucide:circle-x' },
  'not-scheduled': { label: 'Nothing scheduled today', icon: 'lucide:circle' },
} as const;

const cards = persons.map((person) => {
  const todayStatus = resolveTodayStatus(person, entries, goals, today);
  const streak = getBestCurrentStreak(person, entries, goals, today);
  const personGoals = goals.filter((g) => g.person === person);
  const mostRecentEntry = getMostRecentEntry(person, entries, today);

  let miniCalendar: ReturnType<typeof padCalendarDaysForGrid> = [];
  let consistency: number | null = null;
  if (streak) {
    const from = new Date(today);
    from.setUTCDate(from.getUTCDate() - (MINI_CALENDAR_WINDOW_DAYS - 1));
    const days = buildCalendarDays(entries, goals, person, streak.topic, { from, to: today });
    miniCalendar = padCalendarDaysForGrid(days);
    consistency = consistencyForWindow(days);
  }

  return {
    person,
    todayStatus,
    streak,
    goalsSummary: summarizeGoalsByStatus(personGoals),
    miniCalendar,
    consistency,
    mostRecentEntry,
    logUrl: personLogsUrl(person),
    logTodayUrl: `${base}${person}/#log-today`,
  };
});
---

<Base title="Dashboard">
  <div class="dash-header">
    <div>
      <h1>Study Log</h1>
      <p class="dash-subtitle">
        A git-tracked study log — every entry below is a markdown file committed to the repo.
      </p>
    </div>
    <a class="btn btn--primary" href={REPO_URL} target="_blank" rel="noopener">
      <Icon name="lucide:github" class="icon-btn" aria-hidden="true" />
      View repo on GitHub
    </a>
  </div>

  <section class="panel goals-overview-panel">
    <h2 class="section-heading">Goals</h2>
    {
      goalsByPerson.every(({ personGoals }) => personGoals.length === 0) ? (
        <p class="panel-empty">No goals set yet.</p>
      ) : (
        <ul class="goals-overview">
          {goalsByPerson.map(({ person, personGoals }) => (
            <li class="goals-overview-row">
              <a class="goals-overview-person" href={`${base}${person}/goals`}>
                {person}
              </a>
              {personGoals.length === 0 ? (
                <span class="goals-overview-empty">No goals yet</span>
              ) : (
                <ul class="goals-overview-list">
                  {personGoals.map((goal) => (
                    <li>
                      {goal.title}
                      <span class={`goal-status-tag goal-status-tag--${goal.status}`}>
                        {goal.status}
                      </span>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <ul class="overview-grid">
    <li class="overview-card">
      <span class="overview-icon"><Icon name="lucide:clock" aria-hidden="true" /></span>
      <span class="overview-label">Logged today</span>
      <span class="overview-value">{overview.minutesLoggedToday} min</span>
      <span class="overview-sub">
        {overview.entriesLoggedToday} {overview.entriesLoggedToday === 1 ? 'entry' : 'entries'}
      </span>
    </li>
    <li class="overview-card">
      <span class="overview-icon"><Icon name="lucide:users" aria-hidden="true" /></span>
      <span class="overview-label">People tracked</span>
      <span class="overview-value">{overview.totalPeople}</span>
      <span class="overview-sub">{overview.activePeopleCount} active this week</span>
    </li>
    <li class="overview-card">
      <span class="overview-icon overview-icon--flame"><Icon name="lucide:flame" aria-hidden="true" /></span>
      <span class="overview-label">Best current streak</span>
      {
        overview.bestStreak ? (
          <>
            <span class="overview-value">{overview.bestStreak.current} days</span>
            <span class="overview-sub">
              {overview.bestStreak.person} · {overview.bestStreak.topic}
            </span>
          </>
        ) : (
          <>
            <span class="overview-value">—</span>
            <span class="overview-sub">No active streaks yet</span>
          </>
        )
      }
    </li>
    <li class="overview-card overview-card--cta">
      <span class="overview-icon"><Icon name="lucide:sparkles" aria-hidden="true" /></span>
      <span class="overview-label">New here?</span>
      <span class="overview-value overview-value--small">Onboard yourself</span>
      <a class="overview-link" href={`${base}onboarding`}>
        Walk through onboarding <Icon name="lucide:arrow-right" class="icon-inline" aria-hidden="true" />
      </a>
    </li>
  </ul>

  <div class="section-heading-row">
    <h2 class="section-heading">People</h2>
    {
      cards.length > 0 && (
        <div class="view-toggle" role="group" aria-label="People view">
          <button type="button" class="view-toggle-btn" data-view-btn="grid" aria-pressed="true">
            <Icon name="lucide:layout-grid" class="icon-inline" aria-hidden="true" />
            Columns
          </button>
          <button type="button" class="view-toggle-btn" data-view-btn="list" aria-pressed="false">
            <Icon name="lucide:rows-3" class="icon-inline" aria-hidden="true" />
            Rows
          </button>
        </div>
      )
    }
  </div>
  {
    cards.length === 0 ? (
      <p>No one has started logging yet.</p>
    ) : (
      <ul class="card-grid" id="people-grid" data-view="grid">
        {cards.map(
          ({
            person,
            todayStatus,
            streak,
            goalsSummary,
            miniCalendar,
            consistency,
            mostRecentEntry,
            logUrl,
            logTodayUrl,
          }) => (
            <li>
              <div class={`person-card person-card--${todayStatus}`}>
                <div class="card-top">
                  <h3>
                    <a class="card-title-link" href={`${base}${person}/`}>
                      {person}
                    </a>
                  </h3>
                  <span class={`today-badge today-badge--${todayStatus}`}>
                    <Icon
                      name={TODAY_STATUS[todayStatus].icon}
                      class="icon-status"
                      aria-hidden="true"
                    />
                    {TODAY_STATUS[todayStatus].label}
                  </span>
                </div>

                <p class="card-streak">
                  {streak ? (
                    <>
                      <Icon name="lucide:flame" class="icon-flame" aria-hidden="true" />
                      <span>
                        <strong>{streak.current}</strong> day streak · {streak.topic}
                        {streak.longest > streak.current && (
                          <span class="card-streak-best"> (best {streak.longest})</span>
                        )}
                      </span>
                    </>
                  ) : (
                    'No entries yet'
                  )}
                </p>

                {miniCalendar.length > 0 && (
                  <div class="mini-calendar-block">
                    <div
                      class="mini-calendar"
                      role="img"
                      aria-label={`Recent ${streak?.topic} activity`}
                    >
                      {miniCalendar.map((day) =>
                        day === null ? (
                          <span class="mini-day mini-day--empty" />
                        ) : (
                          <span
                            class={`mini-day mini-day--${day.state}`}
                            data-level={
                              day.state === 'completed' ? levelForMinutes(day.minutes) : undefined
                            }
                            title={formatDayTooltip(day)}
                          />
                        )
                      )}
                    </div>
                    {consistency !== null && (
                      <span class="consistency-badge">{consistency}% consistency</span>
                    )}
                  </div>
                )}

                <p class="card-recent">
                  <Icon name="lucide:activity" class="icon-recent" aria-hidden="true" />
                  <span>
                    {mostRecentEntry ? (
                      mostRecentEntry.status === 'completed' ? (
                        <>
                          {mostRecentEntry.title} ·{' '}
                          {formatRelativeDay(mostRecentEntry.date, today)}
                        </>
                      ) : (
                        <>
                          Excused ({mostRecentEntry.reason}) ·{' '}
                          {formatRelativeDay(mostRecentEntry.date, today)}
                        </>
                      )
                    ) : (
                      'No entries logged yet'
                    )}
                  </span>
                </p>

                <p class="card-goals">
                  <Icon name="lucide:target" class="icon-target" aria-hidden="true" />
                  <span>{goalsSummary}</span>
                </p>

                <div class="card-actions">
                  <a class="card-action" href={logUrl} target="_blank" rel="noopener">
                    <Icon name="lucide:github" class="icon-inline" aria-hidden="true" />
                    View logs
                  </a>
                  <a class="card-action card-action--accent" href={logTodayUrl}>
                    <Icon name="lucide:plus" class="icon-inline" aria-hidden="true" />
                    Log today
                  </a>
                </div>
              </div>
            </li>
          )
        )}
      </ul>
    )
  }

  <div class="bottom-grid">
    <section class="panel">
      <h2 class="section-heading">Recent activity</h2>
      {
        recentActivity.length === 0 ? (
          <p class="panel-empty">Nothing logged yet — be the first.</p>
        ) : (
          <ul class="activity-feed">
            {recentActivity.map((item) => (
              <li class="activity-row">
                <span class="activity-when">{formatRelativeDay(item.date, today)}</span>
                <span class="activity-body">
                  <a href={`${base}${item.person}/`}>{item.person}</a>
                  {item.status === 'completed' ? (
                    <>
                      {' '}
                      logged <strong>{item.minutes} min</strong> on {item.topic} —{' '}
                      {item.title}
                    </>
                  ) : (
                    <> was excused — {item.reason}</>
                  )}
                </span>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <section class="panel">
      <h2 class="section-heading">Log a session</h2>
      <p class="panel-copy">
        There's no app to sign into — a session is a markdown file committed to the repo. Open
        one of the links below, fill in the fields GitHub's editor leaves blank, and commit.
      </p>
      <ul class="how-to-list">
        <li>
          <Icon name="lucide:plus" class="icon-inline" aria-hidden="true" />
          <span>
            Use a person card's <strong>Log today</strong> link above to fill in a form, then
            finish the commit on GitHub — see the <a href={`${base}guide`}>logging guide</a> for
            what each field means.
          </span>
        </li>
        <li>
          <Icon name="lucide:book-open" class="icon-inline" aria-hidden="true" />
          <span>
            <a href={`${base}onboarding`}>Onboarding a new person</a> walks through adding a{' '}
            `logs/` and `goals/` folder for someone new.
          </span>
        </li>
        <li>
          <Icon name="lucide:github" class="icon-inline" aria-hidden="true" />
          <span>
            <a href={REPO_URL} target="_blank" rel="noopener">
              Browse the full repo
            </a>{' '}
            to see every entry and goal file as-is.
          </span>
        </li>
      </ul>
    </section>
  </div>
</Base>

<script>
  const STORAGE_KEY = 'grind-log:people-view';
  const grid = document.querySelector<HTMLUListElement>('#people-grid');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-view-btn]');

  function applyView(view: string) {
    if (!grid) return;
    grid.dataset.view = view;
    for (const button of buttons) {
      button.setAttribute('aria-pressed', String(button.dataset.viewBtn === view));
    }
  }

  try {
    const stored = localStorage.getItem(STORAGE_KEY);
    if (stored === 'grid' || stored === 'list') {
      applyView(stored);
    }
  } catch {
    // Private browsing / blocked storage — fall back to the default view.
  }

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const view = button.dataset.viewBtn ?? 'grid';
      applyView(view);
      try {
        localStorage.setItem(STORAGE_KEY, view);
      } catch {
        // Private browsing / blocked storage — the toggle still works,
        // it just won't be remembered next visit.
      }
    });
  }
</script>

<style>
  .dash-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }
  .dash-header h1 {
    margin: 0 0 0.25rem;
  }
  .dash-subtitle {
    margin: 0;
    color: var(--text-dim);
    font-size: 0.95rem;
  }
  .goals-overview-panel {
    margin-bottom: 1.5rem;
  }
  .goals-overview {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .goals-overview-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.75rem;
    font-size: 0.9rem;
  }
  .goals-overview-person {
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
  }
  .goals-overview-empty {
    color: var(--text-dim);
  }
  .goals-overview-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    color: var(--text-dim);
  }
  .goal-status-tag {
    margin-left: 0.35rem;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--text-dim);
  }
  .goal-status-tag--in-progress {
    color: var(--accent);
  }
  .goal-status-tag--achieved {
    color: #3fb950;
  }
  .goal-status-tag--cancelled {
    color: var(--missed-border);
  }

  .overview-grid {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }
  .overview-card {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1rem 1.1rem;
  }
  .overview-icon {
    color: var(--accent);
    margin-bottom: 0.35rem;
  }
  .overview-icon--flame {
    color: #f0883e;
  }
  .overview-icon :global(svg) {
    width: 18px;
    height: 18px;
  }
  .overview-label {
    color: var(--text-dim);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .overview-value {
    font-size: 1.6rem;
    font-weight: 700;
  }
  .overview-value--small {
    font-size: 1.1rem;
  }
  .overview-sub {
    color: var(--text-dim);
    font-size: 0.85rem;
  }
  .overview-card--cta {
    justify-content: space-between;
  }
  .overview-link {
    margin-top: 0.4rem;
    font-size: 0.85rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .section-heading-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .view-toggle {
    display: inline-flex;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 2px;
    margin-bottom: 0.9rem;
  }
  .view-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: none;
    background: transparent;
    color: var(--text-dim);
    font-size: 0.8rem;
    padding: 0.35rem 0.6rem;
    border-radius: 6px;
    cursor: pointer;
  }
  .view-toggle-btn:hover {
    color: var(--text);
  }
  .view-toggle-btn[aria-pressed='true'] {
    background: var(--surface);
    color: var(--text);
  }

  .card-grid {
    list-style: none;
    padding: 0;
    margin: 0 0 2.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    gap: 1rem;
  }
  .card-grid[data-view='list'] {
    grid-template-columns: 1fr;
  }
  .card-grid[data-view='list'] .person-card {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.85rem 1.5rem;
  }
  .card-grid[data-view='list'] .card-top {
    flex: 0 0 auto;
    min-width: 9rem;
  }
  .card-grid[data-view='list'] .card-streak,
  .card-grid[data-view='list'] .card-recent,
  .card-grid[data-view='list'] .card-goals,
  .card-grid[data-view='list'] .mini-calendar-block {
    margin: 0;
  }
  .card-grid[data-view='list'] .card-actions {
    margin-left: auto;
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }
  @media (max-width: 640px) {
    .card-grid[data-view='list'] .person-card {
      flex-direction: column;
      align-items: stretch;
    }
    .card-grid[data-view='list'] .card-actions {
      margin-left: 0;
      padding-top: 0.75rem;
      border-top: 1px solid var(--border);
    }
  }
  .person-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 4px solid var(--not-scheduled);
    border-radius: 10px;
    padding: 1rem;
  }
  .person-card:hover {
    border-color: var(--accent);
  }
  .person-card--completed {
    border-left-color: #26a641;
  }
  .person-card--excused {
    border-left-color: var(--excused);
  }
  .person-card--missed {
    border-left-color: var(--missed-border);
  }
  .card-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .card-top h3 {
    margin: 0;
    font-size: 1.1rem;
  }
  .card-title-link {
    color: var(--text);
  }
  /* Stretched-link pattern: the whole card is clickable via the title
     link's ::after, while the explicit action links below stay on top
     and remain independently clickable. */
  .card-title-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .today-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    color: var(--text-dim);
    white-space: nowrap;
  }
  .icon-status {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }
  .today-badge--completed {
    color: #3fb950;
  }
  .today-badge--excused {
    color: var(--excused);
  }
  .today-badge--missed {
    color: var(--missed-border);
  }
  .card-streak {
    margin: 0.75rem 0 0;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .card-streak-best {
    color: var(--text-dim);
  }
  .icon-flame {
    width: 16px;
    height: 16px;
    color: #f0883e;
    flex-shrink: 0;
  }
  .mini-calendar-block {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 0.75rem 0;
  }
  .mini-calendar {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(7, 1fr);
    gap: 2px;
    width: fit-content;
  }
  .mini-day {
    width: 9px;
    height: 9px;
    border-radius: 2px;
    box-sizing: border-box;
  }
  .mini-day--empty {
    visibility: hidden;
  }
  .mini-day--not-scheduled {
    background: var(--not-scheduled);
  }
  .mini-day--missed {
    background: transparent;
    border: 1px solid var(--missed-border);
  }
  .mini-day--excused {
    background: var(--excused);
  }
  .mini-day--completed[data-level='1'] {
    background: #0e4429;
  }
  .mini-day--completed[data-level='2'] {
    background: #006d32;
  }
  .mini-day--completed[data-level='3'] {
    background: #26a641;
  }
  .mini-day--completed[data-level='4'] {
    background: #39d353;
  }
  .consistency-badge {
    font-size: 0.72rem;
    color: var(--text-dim);
    white-space: nowrap;
  }
  .card-recent {
    display: flex;
    align-items: flex-start;
    gap: 0.35rem;
    margin: 0;
    color: var(--text-dim);
    font-size: 0.85rem;
  }
  .icon-recent {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }
  .card-goals {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0.6rem 0 0;
    color: var(--text-dim);
    font-size: 0.85rem;
  }
  .icon-target {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }
  .card-actions {
    position: relative;
    z-index: 1;
    display: flex;
    gap: 0.5rem;
    margin-top: 0.9rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
  }
  .card-action {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.78rem;
    color: var(--text-dim);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.3rem 0.55rem;
  }
  .card-action:hover {
    text-decoration: none;
    border-color: var(--accent);
    color: var(--text);
  }
  .card-action--accent {
    color: var(--accent);
    border-color: var(--accent);
  }

