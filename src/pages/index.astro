---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import {
  buildCalendarDays,
  consistencyForWindow,
  formatDayTooltip,
  levelForMinutes,
  padCalendarDaysForGrid,
} from '../lib/calendar.js';
import {
  buildRecentActivity,
  computeOverview,
  getBestCurrentStreak,
  getMostRecentEntry,
  resolveTodayStatus,
} from '../lib/dashboard.js';
import { formatRelativeDay } from '../lib/format.js';
import { personLogsUrl, REPO_URL } from '../lib/github.js';
import { summarizeGoalsByStatus } from '../lib/goals.js';
import { getAllPersons } from '../lib/people.js';
import { toScriptJson } from '../lib/serialize.js';
import type { Goal, LogEntry } from '../lib/streaks.js';

const logCollection = await getCollection('logs');
const goalCollection = await getCollection('goals');

const entries: LogEntry[] = logCollection.map((l) => l.data);
const goals: Goal[] = goalCollection.map((g) => g.data);

const persons = getAllPersons(entries, goals);
const today = new Date();
const base = import.meta.env.BASE_URL;

const overview = computeOverview(persons, entries, goals, today);
const RECENT_ACTIVITY_LIMIT = 8;
const recentActivity = buildRecentActivity(entries, RECENT_ACTIVITY_LIMIT, today);

// `idea` goals are a future wishlist, not an active goal — they stay off
// the home page (only the per-person goals page shows them).
const goalsByPerson = persons.map((person) => ({
  person,
  personGoals: goals.filter((g) => g.person === person && g.status !== 'idea'),
}));

// A card-sized peek, not the full calendar — just enough weeks to show
// the shape of recent activity at a glance.
const MINI_CALENDAR_WINDOW_DAYS = 28;

const TODAY_STATUS = {
  completed: { label: 'Completed today', icon: 'lucide:circle-check' },
  excused: { label: 'Excused today', icon: 'lucide:moon' },
  missed: { label: 'Missed today', icon: 'lucide:circle-x' },
  'not-scheduled': { label: 'Nothing scheduled today', icon: 'lucide:circle' },
} as const;
const STATUS_KEYS = Object.keys(TODAY_STATUS) as (keyof typeof TODAY_STATUS)[];

// Everything below derived from `today` — today's status, streaks, the
// mini-calendar, and the overview strip — is rendered here as a build-time
// snapshot (so the page still has sensible content and works without JS),
// then corrected by the client script at the bottom of this file against
// the viewer's real clock, since this is a statically-built site that can
// be viewed long after it was last built.
const dataPayload = toScriptJson({ entries, goals });

const cards = persons.map((person) => {
  const todayStatus = resolveTodayStatus(person, entries, goals, today);
  const streak = getBestCurrentStreak(person, entries, goals, today);
  const personGoals = goals.filter((g) => g.person === person);
  const mostRecentEntry = getMostRecentEntry(person, entries, today);

  let miniCalendar: ReturnType<typeof padCalendarDaysForGrid> = [];
  let consistency: number | null = null;
  if (streak) {
    const from = new Date(today);
    from.setUTCDate(from.getUTCDate() - (MINI_CALENDAR_WINDOW_DAYS - 1));
    const days = buildCalendarDays(entries, goals, person, streak.topic, { from, to: today });
    miniCalendar = padCalendarDaysForGrid(days);
    consistency = consistencyForWindow(days);
  }

  return {
    person,
    todayStatus,
    streak,
    goalsSummary: summarizeGoalsByStatus(personGoals),
    miniCalendar,
    consistency,
    mostRecentEntry,
    logUrl: personLogsUrl(person),
    logTodayUrl: `${base}${person}/#log-today`,
  };
});
---

<Base title="Dashboard">
  <div class="dash-header">
    <div>
      <h1>Study Log</h1>
      <p class="dash-subtitle">
        A git-tracked study log — every entry below is a markdown file committed to the repo.
      </p>
    </div>
    <a class="btn btn--primary" href={REPO_URL} target="_blank" rel="noopener">
      <Icon name="lucide:github" class="icon-btn" aria-hidden="true" />
      View repo on GitHub
    </a>
  </div>

  <section class="panel goals-overview-panel">
    <h2 class="section-heading">Goals</h2>
    {
      goalsByPerson.every(({ personGoals }) => personGoals.length === 0) ? (
        <p class="panel-empty">No goals set yet.</p>
      ) : (
        <ul class="goals-overview">
          {goalsByPerson.map(({ person, personGoals }) => (
            <li class="goals-overview-row">
              <a class="goals-overview-person" href={`${base}${person}/goals`}>
                {person}
              </a>
              {personGoals.length === 0 ? (
                <span class="goals-overview-empty">No goals yet</span>
              ) : (
                <ul class="goals-overview-list">
                  {personGoals.map((goal) => (
                    <li>
                      {goal.title}
                      <span class={`goal-status-tag goal-status-tag--${goal.status}`}>
                        {goal.status}
                      </span>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <ul class="overview-grid">
    <li class="overview-card">
      <span class="overview-icon"><Icon name="lucide:clock" aria-hidden="true" /></span>
      <span class="overview-label">Logged today</span>
      <span class="overview-value" data-overview="minutesLoggedToday">
        {overview.minutesLoggedToday} min
      </span>
      <span class="overview-sub" data-overview="entriesLoggedTodayText">
        {overview.entriesLoggedToday} {overview.entriesLoggedToday === 1 ? 'entry' : 'entries'}
      </span>
    </li>
    <li class="overview-card">
      <span class="overview-icon"><Icon name="lucide:users" aria-hidden="true" /></span>
      <span class="overview-label">People tracked</span>
      <span class="overview-value" data-overview="totalPeople">{overview.totalPeople}</span>
      <span class="overview-sub" data-overview="activePeopleText">
        {overview.activePeopleCount} active this week
      </span>
    </li>
    <li class="overview-card">
      <span class="overview-icon overview-icon--flame"><Icon name="lucide:flame" aria-hidden="true" /></span>
      <span class="overview-label">Best current streak</span>
      <span data-best-streak-has style={`display:${overview.bestStreak ? 'contents' : 'none'}`}>
        <span class="overview-value" data-overview="bestStreakCurrent">
          {overview.bestStreak?.current ?? 0} days
        </span>
        <span class="overview-sub" data-overview="bestStreakSub">
          {overview.bestStreak?.person} · {overview.bestStreak?.topic}
        </span>
      </span>
      <span data-best-streak-none style={`display:${overview.bestStreak ? 'none' : 'contents'}`}>
        <span class="overview-value">—</span>
        <span class="overview-sub">No active streaks yet</span>
      </span>
    </li>
    <li class="overview-card overview-card--cta">
      <span class="overview-icon"><Icon name="lucide:sparkles" aria-hidden="true" /></span>
      <span class="overview-label">New here?</span>
      <span class="overview-value overview-value--small">Onboard yourself</span>
      <a class="overview-link" href={`${base}onboarding`}>
        Walk through onboarding <Icon name="lucide:arrow-right" class="icon-inline" aria-hidden="true" />
      </a>
    </li>
  </ul>

  <div class="section-heading-row">
    <h2 class="section-heading">People</h2>
    {
      cards.length > 0 && (
        <div class="view-toggle" role="group" aria-label="People view">
          <button type="button" class="view-toggle-btn" data-view-btn="grid" aria-pressed="true">
            <Icon name="lucide:layout-grid" class="icon-inline" aria-hidden="true" />
            Columns
          </button>
          <button type="button" class="view-toggle-btn" data-view-btn="list" aria-pressed="false">
            <Icon name="lucide:rows-3" class="icon-inline" aria-hidden="true" />
            Rows
          </button>
        </div>
      )
    }
  </div>
  {
    cards.length === 0 ? (
      <p>No one has started logging yet.</p>
    ) : (
      <ul class="card-grid" id="people-grid" data-view="grid">
        {cards.map(
          ({
            person,
            todayStatus,
            streak,
            goalsSummary,
            miniCalendar,
            consistency,
            mostRecentEntry,
            logUrl,
            logTodayUrl,
          }) => (
            <li>
              <div class="person-card" data-person-card={person} data-today-status={todayStatus}>
                <div class="card-top">
                  <h3>
                    <a class="card-title-link" href={`${base}${person}/`}>
                      {person}
                    </a>
                  </h3>
                  {STATUS_KEYS.map((status) => (
                    <span
                      class={`today-badge today-badge--${status}`}
                      data-status-variant={status}
                      style={status === todayStatus ? undefined : 'display:none'}
                    >
                      <Icon name={TODAY_STATUS[status].icon} class="icon-status" aria-hidden="true" />
                      {TODAY_STATUS[status].label}
                    </span>
                  ))}
                </div>

                <p class="card-streak">
                  <span data-streak-active style={streak ? 'display:contents' : 'display:none'}>
                    <Icon name="lucide:flame" class="icon-flame" aria-hidden="true" />
                    <span>
                      <strong data-streak-current>{streak?.current ?? 0}</strong> day streak ·{' '}
                      <span data-streak-topic>{streak?.topic ?? ''}</span>
                      <span
                        class="card-streak-best"
                        data-streak-best
                        style={streak && streak.longest > streak.current ? undefined : 'display:none'}
                      >
                        {' '}(best <span data-streak-longest>{streak?.longest ?? 0}</span>)
                      </span>
                    </span>
                  </span>
                  <span data-streak-empty style={streak ? 'display:none' : undefined}>
                    No entries yet
                  </span>
                </p>

                <div
                  class="mini-calendar-block"
                  data-mini-calendar-block
                  style={miniCalendar.length > 0 ? undefined : 'display:none'}
                >
                  <div
                    class="mini-calendar"
                    data-mini-calendar
                    role="img"
                    aria-label={`Recent ${streak?.topic} activity`}
                  >
                    {miniCalendar.map((day) =>
                      day === null ? (
                        <span class="mini-day mini-day--empty" />
                      ) : (
                        <span
                          class={`mini-day mini-day--${day.state}`}
                          data-level={
                            day.state === 'completed' ? levelForMinutes(day.minutes) : undefined
                          }
                          title={formatDayTooltip(day)}
                        />
                      )
                    )}
                  </div>
                  <span
                    class="consistency-badge"
                    data-consistency-badge
                    style={consistency !== null ? undefined : 'display:none'}
                  >
                    {consistency}% consistency
                  </span>
                </div>

                <p class="card-recent">
                  <Icon name="lucide:activity" class="icon-recent" aria-hidden="true" />
                  <span>
                    {mostRecentEntry ? (
                      mostRecentEntry.status === 'completed' ? (
                        <>
                          {mostRecentEntry.title} ·{' '}
                          <span class="relative-day" data-date={mostRecentEntry.date.toISOString()}>
                            {formatRelativeDay(mostRecentEntry.date, today)}
                          </span>
                        </>
                      ) : (
                        <>
                          Excused ({mostRecentEntry.reason}) ·{' '}
                          <span class="relative-day" data-date={mostRecentEntry.date.toISOString()}>
                            {formatRelativeDay(mostRecentEntry.date, today)}
                          </span>
                        </>
                      )
                    ) : (
                      'No entries logged yet'
                    )}
                  </span>
                </p>

                <p class="card-goals">
                  <Icon name="lucide:target" class="icon-target" aria-hidden="true" />
                  <span>{goalsSummary}</span>
                </p>

                <div class="card-actions">
                  <a class="card-action" href={logUrl} target="_blank" rel="noopener">
                    <Icon name="lucide:github" class="icon-inline" aria-hidden="true" />
                    View logs
                  </a>
                  <a class="card-action card-action--accent" href={logTodayUrl}>
                    <Icon name="lucide:plus" class="icon-inline" aria-hidden="true" />
                    Log today
                  </a>
                </div>
              </div>
            </li>
          )
        )}
      </ul>
    )
  }

  <div class="bottom-grid">
    <section class="panel">
      <h2 class="section-heading">Recent activity</h2>
      {
        recentActivity.length === 0 ? (
          <p class="panel-empty">Nothing logged yet — be the first.</p>
        ) : (
          <ul class="activity-feed">
            {recentActivity.map((item) => (
              <li class="activity-row">
                <span class="activity-when relative-day" data-date={item.date.toISOString()}>
                  {formatRelativeDay(item.date, today)}
                </span>
                <span class="activity-body">
                  <a href={`${base}${item.person}/`}>{item.person}</a>
                  {item.status === 'completed' ? (
                    <>
                      {' '}
                      logged <strong>{item.minutes} min</strong> on {item.topic} —{' '}
                      {item.title}
                    </>
                  ) : (
                    <> was excused — {item.reason}</>
                  )}
                </span>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <section class="panel">
      <h2 class="section-heading">Log a session</h2>
      <p class="panel-copy">
        There's no app to sign into — a session is a markdown file committed to the repo. Open
        one of the links below, fill in the fields GitHub's editor leaves blank, and commit.
      </p>
      <ul class="how-to-list">
        <li>
          <Icon name="lucide:plus" class="icon-inline" aria-hidden="true" />
          <span>
            Use a person card's <strong>Log today</strong> link above to fill in a form, then
            finish the commit on GitHub — see the <a href={`${base}guide`}>logging guide</a> for
            what each field means.
          </span>
        </li>
        <li>
          <Icon name="lucide:book-open" class="icon-inline" aria-hidden="true" />
          <span>
            <a href={`${base}onboarding`}>Onboarding a new person</a> walks through adding a{' '}
            `logs/` and `goals/` folder for someone new.
          </span>
        </li>
        <li>
          <Icon name="lucide:github" class="icon-inline" aria-hidden="true" />
          <span>
            <a href={REPO_URL} target="_blank" rel="noopener">
              Browse the full repo
            </a>{' '}
            to see every entry and goal file as-is.
          </span>
        </li>
      </ul>
    </section>
  </div>

  <script type="application/json" id="dashboard-data" is:inline set:html={dataPayload}></script>
</Base>

<script>
  import {
    buildCalendarDays,
    consistencyForWindow,
    formatDayTooltip,
    levelForMinutes,
    padCalendarDaysForGrid,
    type CalendarDay,
  } from '../lib/calendar.js';
  import {
    computeOverview,
    getBestCurrentStreak,
    resolveTodayStatus,
    type OverviewStats,
  } from '../lib/dashboard.js';
  import { formatRelativeDay } from '../lib/format.js';
  import { getAllPersons } from '../lib/people.js';
  import { reviveGoals, reviveLogEntries } from '../lib/serialize.js';
  import type { SerializedGoal, SerializedLogEntry } from '../lib/serialize.js';

  // Today's status badges, streaks, the mini-calendar, and the overview
  // strip are all "as of today" — rendered above with a build-time
  // snapshot for a sensible no-JS fallback, then corrected here against
  // the viewer's real clock, since this is a statically-built site that
  // can be viewed long after it was last built.
  const dashboardDataEl = document.querySelector<HTMLScriptElement>('#dashboard-data');
  if (dashboardDataEl) {
    const raw = JSON.parse(dashboardDataEl.textContent!) as {
      entries: SerializedLogEntry[];
      goals: SerializedGoal[];
    };
    const entries = reviveLogEntries(raw.entries);
    const goals = reviveGoals(raw.goals);
    const persons = getAllPersons(entries, goals);
    const today = new Date();

    // A card-sized peek, not the full calendar — just enough weeks to show
    // the shape of recent activity at a glance.
    const MINI_CALENDAR_WINDOW_DAYS = 28;

    function setText(selector: string, text: string) {
      document.querySelector<HTMLElement>(selector)?.replaceChildren(document.createTextNode(text));
    }

    function renderMiniDay(day: CalendarDay | null): HTMLSpanElement {
      const el = document.createElement('span');
      if (day === null) {
        el.className = 'mini-day mini-day--empty';
        return el;
      }
      el.className = `mini-day mini-day--${day.state}`;
      if (day.state === 'completed') {
        el.dataset.level = String(levelForMinutes(day.minutes));
      }
      el.title = formatDayTooltip(day);
      return el;
    }

    function updateOverview(overview: OverviewStats) {
      setText('[data-overview="minutesLoggedToday"]', `${overview.minutesLoggedToday} min`);
      setText(
        '[data-overview="entriesLoggedTodayText"]',
        `${overview.entriesLoggedToday} ${overview.entriesLoggedToday === 1 ? 'entry' : 'entries'}`
      );
      setText('[data-overview="totalPeople"]', String(overview.totalPeople));
      setText('[data-overview="activePeopleText"]', `${overview.activePeopleCount} active this week`);

      const hasEl = document.querySelector<HTMLElement>('[data-best-streak-has]');
      const noneEl = document.querySelector<HTMLElement>('[data-best-streak-none]');
      if (overview.bestStreak) {
        if (hasEl) hasEl.style.display = 'contents';
        if (noneEl) noneEl.style.display = 'none';
        setText('[data-overview="bestStreakCurrent"]', `${overview.bestStreak.current} days`);
        setText(
          '[data-overview="bestStreakSub"]',
          `${overview.bestStreak.person} · ${overview.bestStreak.topic}`
        );
      } else {
        if (hasEl) hasEl.style.display = 'none';
        if (noneEl) noneEl.style.display = 'contents';
      }
    }

    updateOverview(computeOverview(persons, entries, goals, today));

    for (const card of document.querySelectorAll<HTMLElement>('[data-person-card]')) {
      const person = card.dataset.personCard!;
      const todayStatus = resolveTodayStatus(person, entries, goals, today);
      card.dataset.todayStatus = todayStatus;
      for (const variant of card.querySelectorAll<HTMLElement>('[data-status-variant]')) {
        variant.style.display = variant.dataset.statusVariant === todayStatus ? '' : 'none';
      }

      const streak = getBestCurrentStreak(person, entries, goals, today);
      const activeEl = card.querySelector<HTMLElement>('[data-streak-active]');
      const emptyEl = card.querySelector<HTMLElement>('[data-streak-empty]');

      if (streak) {
        if (activeEl) activeEl.style.display = 'contents';
        if (emptyEl) emptyEl.style.display = 'none';
        const currentEl = card.querySelector<HTMLElement>('[data-streak-current]');
        if (currentEl) currentEl.textContent = String(streak.current);
        const topicEl = card.querySelector<HTMLElement>('[data-streak-topic]');
        if (topicEl) topicEl.textContent = streak.topic;
        const bestEl = card.querySelector<HTMLElement>('[data-streak-best]');
        if (bestEl) {
          if (streak.longest > streak.current) {
            bestEl.style.display = '';
            const longestEl = card.querySelector<HTMLElement>('[data-streak-longest]');
            if (longestEl) longestEl.textContent = String(streak.longest);
          } else {
            bestEl.style.display = 'none';
          }
        }
      } else {
        if (activeEl) activeEl.style.display = 'none';
        if (emptyEl) emptyEl.style.display = '';
      }

      const miniBlock = card.querySelector<HTMLElement>('[data-mini-calendar-block]');
      const miniGrid = card.querySelector<HTMLElement>('[data-mini-calendar]');
      const consistencyEl = card.querySelector<HTMLElement>('[data-consistency-badge]');

      if (streak && miniBlock && miniGrid) {
        const from = new Date(today);
        from.setUTCDate(from.getUTCDate() - (MINI_CALENDAR_WINDOW_DAYS - 1));
        const days = buildCalendarDays(entries, goals, person, streak.topic, { from, to: today });
        miniGrid.setAttribute('aria-label', `Recent ${streak.topic} activity`);
        miniGrid.replaceChildren(...padCalendarDaysForGrid(days).map(renderMiniDay));

        const consistency = consistencyForWindow(days);
        if (consistencyEl) {
          if (consistency !== null) {
            consistencyEl.style.display = '';
            consistencyEl.textContent = `${consistency}% consistency`;
          } else {
            consistencyEl.style.display = 'none';
          }
        }
        miniBlock.style.display = '';
      } else {
        miniGrid?.replaceChildren();
        if (miniBlock) miniBlock.style.display = 'none';
      }
    }
  }

  // Labels are rendered with the build-time date server-side, then
  // corrected here against the viewer's real clock — this is a
  // statically-built site, so pages can be viewed long after they were
  // built and "today"/"yesterday" would otherwise drift stale.
  for (const el of document.querySelectorAll<HTMLElement>('.relative-day')) {
    const iso = el.dataset.date;
    if (!iso) continue;
    el.textContent = formatRelativeDay(new Date(iso));
  }

  const STORAGE_KEY = 'grind-log:people-view';
  const grid = document.querySelector<HTMLUListElement>('#people-grid');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-view-btn]');

  function applyView(view: string) {
    if (!grid) return;
    grid.dataset.view = view;
    for (const button of buttons) {
      button.setAttribute('aria-pressed', String(button.dataset.viewBtn === view));
    }
  }

  try {
    const stored = localStorage.getItem(STORAGE_KEY);
    if (stored === 'grid' || stored === 'list') {
      applyView(stored);
    }
  } catch {
    // Private browsing / blocked storage — fall back to the default view.
  }

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const view = button.dataset.viewBtn ?? 'grid';
      applyView(view);
      try {
        localStorage.setItem(STORAGE_KEY, view);
      } catch {
        // Private browsing / blocked storage — the toggle still works,
        // it just won't be remembered next visit.
      }
    });
  }
</script>

<style>
  .dash-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }
  .dash-header h1 {
    margin: 0 0 0.25rem;
  }
  .dash-subtitle {
    margin: 0;
    color: var(--text-dim);
    font-size: 0.95rem;
  }
  .goals-overview-panel {
    margin-bottom: 1.5rem;
  }
  .goals-overview {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .goals-overview-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.75rem;
    font-size: 0.9rem;
  }
  .goals-overview-person {
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
  }
  .goals-overview-empty {
    color: var(--text-dim);
  }
  .goals-overview-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    color: var(--text-dim);
  }
  .goal-status-tag {
    margin-left: 0.35rem;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--text-dim);
  }
  .goal-status-tag--in-progress {
    color: var(--accent);
  }
  .goal-status-tag--achieved {
    color: #3fb950;
  }
  .goal-status-tag--cancelled {
    color: var(--missed-border);
  }

  .overview-grid {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }
  .overview-card {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1rem 1.1rem;
  }
  .overview-icon {
    color: var(--accent);
    margin-bottom: 0.35rem;
  }
  .overview-icon--flame {
    color: #f0883e;
  }
  .overview-icon :global(svg) {
    width: 18px;
    height: 18px;
  }
  .overview-label {
    color: var(--text-dim);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
