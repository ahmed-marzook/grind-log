---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PersonNav from '../../components/PersonNav.astro';
import GoalEntryForm from '../../components/GoalEntryForm.astro';
import { getPersonTopics } from '../../lib/calendar.js';
import { formatMinutes } from '../../lib/format.js';
import { goalFileUrl } from '../../lib/github.js';
import { describeGoalTimeline, getGoalActivity, groupBy, STATUS_ORDER } from '../../lib/goals.js';
import { Icon } from 'astro-icon/components';
import { getAllPersons } from '../../lib/people.js';

export async function getStaticPaths() {
  const logs = await getCollection('logs');
  const goals = await getCollection('goals');
  const persons = getAllPersons(logs.map((l) => l.data), goals.map((g) => g.data));
  return persons.map((person) => ({ params: { person } }));
}

const { person } = Astro.params as { person: string };
const logs = await getCollection('logs', (entry) => entry.data.person === person);
const goals = await getCollection('goals', (entry) => entry.data.person === person);
const topics = getPersonTopics(
  person,
  logs.map((l) => l.data),
  goals.map((g) => g.data)
);

const logEntries = logs.map((l) => l.data);
const goalsWithContent = await Promise.all(
  goals.map(async (goal) => ({
    goal,
    Content: (await goal.render()).Content,
    activity: getGoalActivity(goal.data, logEntries),
    // Build-time snapshot; corrected client-side against the real date.
    timeline: describeGoalTimeline(goal.data, new Date()),
  }))
);

const grouped = groupBy(goalsWithContent, (item) => item.goal.data.status, STATUS_ORDER);
const futureIdeas = goalsWithContent.filter((item) => item.goal.data.status === 'idea');

const STATUS_LABEL: Record<(typeof STATUS_ORDER)[number], string> = {
  'in-progress': 'In progress',
  pending: 'Pending',
  achieved: 'Achieved',
  cancelled: 'Cancelled',
};

// Achieved/cancelled goals stay visible but start collapsed — the point
// is seeing follow-through over time, not hiding goals that didn't pan out.
const COLLAPSED_BY_DEFAULT = new Set(['achieved', 'cancelled']);

function formatDate(date: Date): string {
  return date.toISOString().slice(0, 10);
}
---

<Base title={`${person} · goals`}>
  <h1>{person}'s goals</h1>
  <PersonNav person={person} active="goals" />
  <GoalEntryForm person={person} topics={topics} />

  {
    goalsWithContent.length === 0 ? (
      <p>No goals yet.</p>
    ) : (
      STATUS_ORDER.map((status) => {
        const items = grouped[status];
        if (items.length === 0) return null;
        return (
          <details class="status-group" open={!COLLAPSED_BY_DEFAULT.has(status)}>
            <summary>
              {STATUS_LABEL[status]} ({items.length})
            </summary>
            <ul class="goal-list">
              {items.map(({ goal, Content, activity, timeline }) => (
                <li class="goal-card">
                  <div class="goal-header">
                    <h2>{goal.data.title}</h2>
                    <span class="goal-topic">{goal.data.topic}</span>
                  </div>
                  {(goal.data.started || goal.data.target_date) && (
                    <p class="goal-dates">
                      {goal.data.started && <>Started {formatDate(goal.data.started)}</>}
                      {goal.data.started && goal.data.target_date && ' · '}
                      {goal.data.target_date && <>Target {formatDate(goal.data.target_date)}</>}
                    </p>
                  )}
                  <p class="goal-progress">
                    <span
                      class={`goal-timeline goal-timeline--${timeline?.tone ?? 'neutral'}`}
                      data-goal-timeline={JSON.stringify({
                        status: goal.data.status,
                        started: goal.data.started?.toISOString(),
                        target_date: goal.data.target_date?.toISOString(),
                      })}
                      hidden={!timeline}
                    >
                      {timeline?.label}
                    </span>
                    <span class="goal-activity">
                      {activity.sessions === 0
                        ? 'No sessions logged yet'
                        : `${activity.sessions} session${activity.sessions === 1 ? '' : 's'} · ${formatMinutes(activity.minutes)} logged`}
                    </span>
                    <a class="goal-source" href={goalFileUrl(goal.id)} target="_blank" rel="noopener">
                      <Icon name="lucide:github" class="goal-source-icon" aria-hidden="true" />
                      Edit on GitHub
                    </a>
                  </p>
                  <div class="goal-body">
                    <Content />
                  </div>
                </li>
              ))}
            </ul>
          </details>
        );
      })
    )
  }

  {
    futureIdeas.length > 0 && (
      <details class="status-group future-ideas-group" open>
        <summary>Future ideas ({futureIdeas.length})</summary>
        <p class="future-ideas-note">
          Not committed to yet — no schedule, no streak tracking. Just things worth remembering
          for later.
        </p>
        <ul class="goal-list">
          {futureIdeas.map(({ goal, Content }) => (
            <li class="goal-card goal-card--idea">
              <div class="goal-header">
                <h2>{goal.data.title}</h2>
                <span class="goal-topic">{goal.data.topic}</span>
              </div>
              <p class="goal-progress">
                <a class="goal-source" href={goalFileUrl(goal.id)} target="_blank" rel="noopener">
                  <Icon name="lucide:github" class="goal-source-icon" aria-hidden="true" />
                  Edit on GitHub
                </a>
              </p>
              <div class="goal-body">
                <Content />
              </div>
            </li>
          ))}
        </ul>
      </details>
    )
  }
</Base>

<script>
  import { describeGoalTimeline } from '../../lib/goals.js';
  import type { Goal } from '../../lib/streaks.js';

  // "Day N · X days left / overdue" depends on today's date, so recompute
  // it against the viewer's real clock (see CLAUDE.md) rather than trust
  // the build-time snapshot.
  const today = new Date();
  for (const el of document.querySelectorAll<HTMLElement>('[data-goal-timeline]')) {
    const raw = JSON.parse(el.dataset.goalTimeline!) as {
      status: Goal['status'];
      started?: string;
      target_date?: string;
    };
    const timeline = describeGoalTimeline(
      {
        status: raw.status,
        started: raw.started ? new Date(raw.started) : undefined,
        target_date: raw.target_date ? new Date(raw.target_date) : undefined,
      },
      today
    );
    el.hidden = !timeline;
    el.textContent = timeline?.label ?? '';
    el.className = `goal-timeline goal-timeline--${timeline?.tone ?? 'neutral'}`;
  }
</script>

<style>
  .goal-progress {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.9rem;
    margin: 0.4rem 0 0;
    font-size: 0.85rem;
    color: var(--text-dim);
  }
  .goal-timeline {
    font-weight: 600;
  }
  .goal-timeline[hidden] {
    display: none;
  }
  .goal-timeline--soon {
    color: var(--excused);
  }
  .goal-timeline--overdue {
    color: var(--missed-border);
  }
  .goal-source {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-left: auto;
    color: var(--text-dim);
  }
  .goal-source:hover {
    color: var(--text);
  }
  .goal-source-icon {
    width: 0.9em;
    height: 0.9em;
  }
  .status-group {
    margin-bottom: 1.5rem;
  }
  .status-group summary {
    cursor: pointer;
    font-weight: 600;
    padding: 0.5rem 0;
  }
  .goal-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 0.75rem;
  }
  .goal-card {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem;
  }
  .goal-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .goal-header h2 {
    margin: 0;
    font-size: 1.05rem;
  }
  .goal-topic {
    color: var(--text-dim);
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .goal-dates {
    margin: 0.25rem 0 0;
    color: var(--text-dim);
    font-size: 0.85rem;
  }
  .goal-body {
    margin-top: 0.75rem;
    color: var(--text-dim);
    font-size: 0.95rem;
  }
  .goal-body :global(p:first-child) {
    margin-top: 0;
  }
  .goal-body :global(p:last-child) {
    margin-bottom: 0;
  }
  .future-ideas-group {
    border-top: 1px dashed var(--border);
    padding-top: 1rem;
  }
  .future-ideas-note {
    margin: 0 0 0.75rem;
    color: var(--text-dim);
    font-size: 0.85rem;
    font-style: italic;
  }
  .goal-card--idea {
    border-style: dashed;
  }
</style>
