---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PersonNav from '../../components/PersonNav.astro';
import { getPersonTopics } from '../../lib/calendar.js';
import { getAllPersons } from '../../lib/people.js';
import { toScriptJson } from '../../lib/serialize.js';
import type { Goal, LogEntry } from '../../lib/streaks.js';

export async function getStaticPaths() {
  const logs = await getCollection('logs');
  const goals = await getCollection('goals');
  const persons = getAllPersons(logs.map((l) => l.data), goals.map((g) => g.data));
  return persons.map((person) => ({ params: { person } }));
}

const { person } = Astro.params as { person: string };

const entries: LogEntry[] = (await getCollection('logs', (e) => e.data.person === person)).map(
  (l) => l.data
);
const goals: Goal[] = (await getCollection('goals', (g) => g.data.person === person)).map(
  (g) => g.data
);

// The day-by-day state and streak numbers below depend on "today" — this
// is a statically-built site, so anything computed from `new Date()` here
// would be frozen to build time and go stale between rebuilds. The
// skeleton below is filled in (and kept correct) by the client script at
// the bottom of this file instead, using the viewer's real clock. The
// heatmap itself (an ApexCharts chart) is client-rendered entirely —
// there's no server-side render path for it.
const topics = getPersonTopics(person, entries, goals);
const dataPayload = toScriptJson({ entries, goals });
---

<Base title={`${person} · calendar`}>
  <h1>{person}'s calendar</h1>
  <PersonNav person={person} active="calendar" />

  {
    topics.length === 0 ? (
      <p>No topics logged yet.</p>
    ) : (
      <div id="calendar-app" data-person={person}>
        <noscript>
          <p class="panel-empty">
            The calendar and streaks need JavaScript enabled to render — everything else on the
            site works without it.
          </p>
        </noscript>

        <label class="topic-filter">
          Topic:
          <select id="topic-select">
            {topics.map((topic, i) => (
              <option value={topic} selected={i === 0}>
                {topic}
              </option>
            ))}
          </select>
        </label>

        {topics.map((topic, i) => (
          <section class="topic-panel" data-topic-section={topic} hidden={i !== 0}>
            <p class="streaks" data-streak-text>
              Loading streak…
            </p>
            <div class="calendar-chart" data-calendar-chart aria-label={`${topic} activity`} />
            <ul class="legend">
              <li>
                <span class="swatch swatch--completed" /> Completed
              </li>
              <li>
                <span class="swatch swatch--excused" /> Excused
              </li>
              <li>
                <span class="swatch swatch--missed" /> Missed
              </li>
              <li>
                <span class="swatch swatch--not-scheduled" /> Not scheduled
              </li>
            </ul>
          </section>
        ))}

        <script type="application/json" id="calendar-data" is:inline set:html={dataPayload}></script>
      </div>
    )
  }
</Base>

<script>
  import ApexCharts from 'apexcharts';
  import { buildCalendarDays, formatDayTooltip, levelForMinutes, type CalendarDay } from '../../lib/calendar.js';
  import { reviveGoals, reviveLogEntries } from '../../lib/serialize.js';
  import { calculateStreak } from '../../lib/streaks.js';
  import type { SerializedGoal, SerializedLogEntry } from '../../lib/serialize.js';

  const app = document.querySelector<HTMLElement>('#calendar-app');
  if (app) {
    const person = app.dataset.person!;
    const dataEl = document.querySelector<HTMLScriptElement>('#calendar-data')!;
    const raw = JSON.parse(dataEl.textContent!) as {
      entries: SerializedLogEntry[];
      goals: SerializedGoal[];
    };
    const entries = reviveLogEntries(raw.entries);
    const goals = reviveGoals(raw.goals);

    const today = new Date();

    // How far back to render when a topic has no goal start date and no
    // entries yet — just enough to show a non-empty grid, not a schedule.
    const DEFAULT_LOOKBACK_DAYS = 84;

    // Day-state codes mapped to fixed colors via colorScale ranges below —
    // a heatmap's color axis is normally a continuous scale, so each
    // state (plus each completed intensity level) gets its own exact-value
    // range rather than a gradient.
    const CODE_PAD = -99;
    const CODE_NOT_SCHEDULED = 0;
    const CODE_MISSED = -1;
    const CODE_EXCUSED = -2;
    const CODE_COMPLETED_BASE = 0; // + levelForMinutes (1-4)

    const style = getComputedStyle(document.documentElement);
    const cssVar = (name: string) => style.getPropertyValue(name).trim();
    const COLORS = {
      pad: 'transparent',
      notScheduled: cssVar('--not-scheduled') || '#20232b',
      missed: cssVar('--missed-border') || '#f85149',
      excused: cssVar('--excused') || '#d29922',
      completed: ['#0e4429', '#006d32', '#26a641', '#39d353'],
      text: cssVar('--text-dim') || '#9aa1ab',
      border: cssVar('--border') || '#2a2e37',
      surface: cssVar('--surface') || '#171a21',
    };

    function dayCode(day: CalendarDay | null): number {
      if (day === null) return CODE_PAD;
      if (day.state === 'not-scheduled') return CODE_NOT_SCHEDULED;
      if (day.state === 'missed') return CODE_MISSED;
      if (day.state === 'excused') return CODE_EXCUSED;
      return CODE_COMPLETED_BASE + levelForMinutes(day.minutes);
    }

    const WEEKDAY_ROWS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    const MONTH_ABBREV = [
      'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec',
    ];

    function earliestFor(topic: string): Date {
      const goal = goals.find(
        (g) => g.person === person && g.topic === topic && g.status === 'in-progress'
      );
      const candidates: Date[] = [];
      if (goal?.started) candidates.push(goal.started);
      for (const e of entries) {
        if (e.person === person && e.status === 'completed' && e.topic === topic) {
          candidates.push(e.date);
        }
      }
      if (candidates.length === 0) {
        const fallback = new Date(today);
        fallback.setUTCDate(fallback.getUTCDate() - DEFAULT_LOOKBACK_DAYS);
        return fallback;
      }
      return new Date(Math.min(...candidates.map((d) => d.getTime())));
    }

    // Pads the front so the first real day lands in its correct weekday
    // row (row 0 = Sunday), matching WEEKDAY_ROWS, then reshapes into
    // week-columns for the heatmap's 7-row x N-week layout.
    function toWeekColumns(days: CalendarDay[]): (CalendarDay | null)[][] {
      if (days.length === 0) return [];
      const firstDow = new Date(`${days[0].date}T00:00:00.000Z`).getUTCDay();
      const padded: (CalendarDay | null)[] = [...Array(firstDow).fill(null), ...days];
      while (padded.length % 7 !== 0) padded.push(null);
      const weeks: (CalendarDay | null)[][] = [];
      for (let i = 0; i < padded.length; i += 7) {
        weeks.push(padded.slice(i, i + 7));
      }
      return weeks;
    }

    function buildSeries(weeks: (CalendarDay | null)[][]) {
      // Sparse month labels along the top, GitHub-style — only the first
      // week of each month (and the very first column) gets a label. The
      // heatmap reads each point's own `x` as its category label (a
      // separate xaxis.categories array is ignored for this chart type),
      // so the label has to travel with the data point itself.
      let lastMonth = -1;
      const columnLabels = weeks.map((week) => {
        const firstRealDay = week.find((d) => d !== null);
        if (!firstRealDay) return ' ';
        const month = new Date(`${firstRealDay.date}T00:00:00.000Z`).getUTCMonth();
        if (month !== lastMonth) {
          lastMonth = month;
          return MONTH_ABBREV[month];
        }
        return ' ';
      });

      return WEEKDAY_ROWS.map((name, row) => ({
        name,
        data: weeks.map((week, col) => ({ x: columnLabels[col], y: dayCode(week[row]) })),
      }));
    }

    const charts = new Map<string, ApexCharts>();

    function renderChart(section: HTMLElement, topic: string) {
      const container = section.querySelector<HTMLElement>('[data-calendar-chart]')!;
      const streakText = section.querySelector<HTMLElement>('[data-streak-text]')!;

      const from = earliestFor(topic);
      const days = buildCalendarDays(entries, goals, person, topic, { from, to: today });
      const streak = calculateStreak(entries, goals, person, topic, today);

      const currentEl = document.createElement('strong');
      currentEl.textContent = String(streak.current);
      const longestEl = document.createElement('strong');
      longestEl.textContent = String(streak.longest);
      streakText.replaceChildren(
        currentEl,
        ' day current streak · ',
        longestEl,
        ' day longest streak'
      );

      const weeks = toWeekColumns(days);
      const series = buildSeries(weeks);

      // seriesIndex/dataPointIndex from ApexCharts' tooltip callback map
      // straight back to weeks[col][row] — the same shape the series/
      // categories were built from — so the tooltip can show the real
      // title/minutes/reason instead of just the numeric color code.
      const chart = new ApexCharts(container, {
        chart: {
          type: 'heatmap',
          height: 190,
          background: 'transparent',
          toolbar: { show: false },
          fontFamily: 'inherit',
          // A status dashboard, not a decorative chart — render settled
          // and instantly rather than animating cells in.
          animations: { enabled: false },
        },
        theme: { mode: 'dark' },
        series,
        xaxis: {
          labels: { style: { colors: COLORS.text, fontSize: '11px' } },
          axisBorder: { show: false },
          axisTicks: { show: false },
        },
        yaxis: {
          labels: { style: { colors: COLORS.text, fontSize: '11px' } },
        },
        grid: { show: false, padding: { left: 0, right: 0 } },
        legend: { show: false },
        dataLabels: { enabled: false },
        stroke: { width: 3, colors: [COLORS.surface] },
        plotOptions: {
          heatmap: {
            radius: 2,
            // Each state is an exact single-value range, not a gradient —
            // enableShades:false stops ApexCharts perturbing those colors
            // by cell position, and ranges must be ascending by `from` or
            // matching silently breaks.
            enableShades: false,
            colorScale: {
              ranges: [
                { from: CODE_PAD, to: CODE_PAD, color: COLORS.pad, name: 'padding' },
                { from: CODE_EXCUSED, to: CODE_EXCUSED, color: COLORS.excused, name: 'Excused' },
                { from: CODE_MISSED, to: CODE_MISSED, color: COLORS.missed, name: 'Missed' },
                {
                  from: CODE_NOT_SCHEDULED,
                  to: CODE_NOT_SCHEDULED,
                  color: COLORS.notScheduled,
                  name: 'Not scheduled',
                },
                { from: 1, to: 1, color: COLORS.completed[0], name: 'Completed' },
                { from: 2, to: 2, color: COLORS.completed[1], name: 'Completed' },
                { from: 3, to: 3, color: COLORS.completed[2], name: 'Completed' },
                { from: 4, to: 4, color: COLORS.completed[3], name: 'Completed' },
              ],
            },
          },
        },
        tooltip: {
          custom: ({ seriesIndex, dataPointIndex }: { seriesIndex: number; dataPointIndex: number }) => {
            const day = weeks[dataPointIndex]?.[seriesIndex];
            if (!day) return '';
            const text = formatDayTooltip(day);
            return `<div style="background:${COLORS.surface};border:1px solid ${COLORS.border};color:${COLORS.text};padding:6px 9px;border-radius:6px;font-size:12px;max-width:220px;">${escapeHtml(text)}</div>`;
          },
        },
      });

      chart.render();
      charts.set(topic, chart);
    }

    function escapeHtml(text: string): string {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    function ensureChartForTopic(topic: string) {
      if (charts.has(topic)) return;
      const section = app!.querySelector<HTMLElement>(`[data-topic-section="${CSS.escape(topic)}"]`);
      if (section) renderChart(section, topic);
    }

    const select = document.querySelector<HTMLSelectElement>('#topic-select');
    const sections = app.querySelectorAll<HTMLElement>('[data-topic-section]');

    if (select) {
      ensureChartForTopic(select.value);
      select.addEventListener('change', () => {
        for (const s of sections) {
          s.hidden = s.dataset.topicSection !== select.value;
        }
        ensureChartForTopic(select.value);
      });
    }
  }
</script>

<style>
  .panel-empty {
    color: var(--text-dim);
  }
  .topic-filter {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    color: var(--text-dim);
  }
  .streaks {
    margin: 0 0 1rem;
  }
  .calendar-chart {
    max-width: 900px;
    margin-bottom: 0.5rem;
  }
  .legend {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 0;
    margin: 1rem 0 2rem;
    color: var(--text-dim);
    font-size: 0.85rem;
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .swatch {
    width: 12px;
    height: 12px;
    border-radius: 2px;
    display: inline-block;
  }
  .swatch--completed {
    background: #26a641;
  }
  .swatch--excused {
    background: var(--excused);
  }
  .swatch--missed {
    background: var(--missed-border);
  }
  .swatch--not-scheduled {
    background: var(--not-scheduled);
  }
</style>
