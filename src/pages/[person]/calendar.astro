---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PersonNav from '../../components/PersonNav.astro';
import { getPersonTopics } from '../../lib/calendar.js';
import { getAllPersons } from '../../lib/people.js';
import { toScriptJson } from '../../lib/serialize.js';
import type { Goal, LogEntry } from '../../lib/streaks.js';

export async function getStaticPaths() {
  const logs = await getCollection('logs');
  const goals = await getCollection('goals');
  const persons = getAllPersons(logs.map((l) => l.data), goals.map((g) => g.data));
  return persons.map((person) => ({ params: { person } }));
}

const { person } = Astro.params as { person: string };

const entries: LogEntry[] = (await getCollection('logs', (e) => e.data.person === person)).map(
  (l) => l.data
);
const goals: Goal[] = (await getCollection('goals', (g) => g.data.person === person)).map(
  (g) => g.data
);

// The day-by-day state and streak numbers below depend on "today" — this
// is a statically-built site, so anything computed from `new Date()` here
// would be frozen to build time and go stale between rebuilds. The
// skeleton below is filled in (and kept correct) by the client script at
// the bottom of this file instead, using the viewer's real clock.
const topics = getPersonTopics(person, entries, goals);
const dataPayload = toScriptJson({ entries, goals });
---

<Base title={`${person} · calendar`}>
  <h1>{person}'s calendar</h1>
  <PersonNav person={person} active="calendar" />

  {
    topics.length === 0 ? (
      <p>No topics logged yet.</p>
    ) : (
      <div id="calendar-app" data-person={person}>
        <noscript>
          <p class="panel-empty">
            The calendar and streaks need JavaScript enabled to render — everything else on the
            site works without it.
          </p>
        </noscript>

        <label class="topic-filter">
          Topic:
          <select id="topic-select">
            {topics.map((topic, i) => (
              <option value={topic} selected={i === 0}>
                {topic}
              </option>
            ))}
          </select>
        </label>

        {topics.map((topic, i) => (
          <section class="topic-panel" data-topic-section={topic} hidden={i !== 0}>
            <p class="streaks" data-streak-text>
              Loading streak…
            </p>
            <div class="calendar-grid" data-calendar-grid aria-label={`${topic} activity`} />
            <ul class="legend">
              <li>
                <span class="swatch swatch--completed" /> Completed
              </li>
              <li>
                <span class="swatch swatch--excused" /> Excused
              </li>
              <li>
                <span class="swatch swatch--missed" /> Missed
              </li>
              <li>
                <span class="swatch swatch--not-scheduled" /> Not scheduled
              </li>
            </ul>
          </section>
        ))}

        <script type="application/json" id="calendar-data" is:inline set:html={dataPayload}></script>
      </div>
    )
  }
</Base>

<script>
  import {
    buildCalendarDays,
    formatDayTooltip,
    levelForMinutes,
    padCalendarDaysForGrid,
    type CalendarDay,
  } from '../../lib/calendar.js';
  import { reviveGoals, reviveLogEntries } from '../../lib/serialize.js';
  import { calculateStreak } from '../../lib/streaks.js';
  import type { SerializedGoal, SerializedLogEntry } from '../../lib/serialize.js';

  const app = document.querySelector<HTMLElement>('#calendar-app');
  if (app) {
    const person = app.dataset.person!;
    const dataEl = document.querySelector<HTMLScriptElement>('#calendar-data')!;
    const raw = JSON.parse(dataEl.textContent!) as {
      entries: SerializedLogEntry[];
      goals: SerializedGoal[];
    };
    const entries = reviveLogEntries(raw.entries);
    const goals = reviveGoals(raw.goals);

    const today = new Date();

    // How far back to render when a topic has no goal start date and no
    // entries yet — just enough to show a non-empty grid, not a schedule.
    const DEFAULT_LOOKBACK_DAYS = 84;

    function earliestFor(topic: string): Date {
      const goal = goals.find(
        (g) => g.person === person && g.topic === topic && g.status === 'in-progress'
      );
      const candidates: Date[] = [];
      if (goal?.started) candidates.push(goal.started);
      for (const e of entries) {
        if (e.person === person && e.status === 'completed' && e.topic === topic) {
          candidates.push(e.date);
        }
      }
      if (candidates.length === 0) {
        const fallback = new Date(today);
        fallback.setUTCDate(fallback.getUTCDate() - DEFAULT_LOOKBACK_DAYS);
        return fallback;
      }
      return new Date(Math.min(...candidates.map((d) => d.getTime())));
    }

    function renderDay(day: CalendarDay | null): HTMLDivElement {
      const el = document.createElement('div');
      if (day === null) {
        el.className = 'day day--empty';
        return el;
      }
      el.className = `day day--${day.state}`;
      if (day.state === 'completed') {
        el.dataset.level = String(levelForMinutes(day.minutes));
      }
      el.title = formatDayTooltip(day);
      return el;
    }

    for (const section of app.querySelectorAll<HTMLElement>('[data-topic-section]')) {
      const topic = section.dataset.topicSection!;
      const streakText = section.querySelector<HTMLElement>('[data-streak-text]')!;
      const grid = section.querySelector<HTMLElement>('[data-calendar-grid]')!;

      const from = earliestFor(topic);
      const days = buildCalendarDays(entries, goals, person, topic, { from, to: today });
      const streak = calculateStreak(entries, goals, person, topic, today);

      const currentEl = document.createElement('strong');
      currentEl.textContent = String(streak.current);
      const longestEl = document.createElement('strong');
      longestEl.textContent = String(streak.longest);
      streakText.replaceChildren(
        currentEl,
        ' day current streak · ',
        longestEl,
        ' day longest streak'
      );

      const padded = padCalendarDaysForGrid(days);
      grid.replaceChildren(...padded.map(renderDay));
    }

    const select = document.querySelector<HTMLSelectElement>('#topic-select');
    const sections = document.querySelectorAll<HTMLElement>('[data-topic-section]');
    select?.addEventListener('change', () => {
      for (const s of sections) {
        s.hidden = s.dataset.topicSection !== select.value;
      }
    });
  }
</script>

<style>
  .panel-empty {
    color: var(--text-dim);
  }
  .topic-filter {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    color: var(--text-dim);
  }
  .streaks {
    margin: 0 0 1rem;
  }
  .calendar-grid {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(7, 1fr);
    gap: 3px;
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }
  /* :global() here — these classes are set on <div>s created with
     document.createElement() by the client script below, which never get
     Astro's scoped-style attribute, so a plain (scoped) selector would
     silently never match them. */
  :global(.day) {
    width: 12px;
    height: 12px;
    border-radius: 2px;
    box-sizing: border-box;
  }
  :global(.day--empty) {
    visibility: hidden;
  }
  :global(.day--not-scheduled) {
    background: var(--not-scheduled);
  }
  :global(.day--missed) {
    background: transparent;
    border: 1px solid var(--missed-border);
  }
  :global(.day--excused) {
    background: var(--excused);
  }
  :global(.day--completed[data-level='1']) {
    background: #0e4429;
  }
  :global(.day--completed[data-level='2']) {
    background: #006d32;
  }
  :global(.day--completed[data-level='3']) {
    background: #26a641;
  }
  :global(.day--completed[data-level='4']) {
    background: #39d353;
  }
  .legend {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 0;
    margin: 1rem 0 2rem;
    color: var(--text-dim);
    font-size: 0.85rem;
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .swatch {
    width: 12px;
    height: 12px;
    border-radius: 2px;
    display: inline-block;
  }
  .swatch--completed {
    background: #26a641;
  }
  .swatch--excused {
    background: var(--excused);
  }
  .swatch--missed {
    background: transparent;
    border: 1px solid var(--missed-border);
  }
  .swatch--not-scheduled {
    background: var(--not-scheduled);
  }
</style>
