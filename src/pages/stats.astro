---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { summarizeGoalsByStatus } from '../lib/goals.js';
import { getAllPersons } from '../lib/people.js';

const logs = await getCollection('logs');
const goals = await getCollection('goals');
const persons = getAllPersons(logs.map((l) => l.data), goals.map((g) => g.data));

const summaries = persons.map((person) => {
  const personGoals = goals.filter((g) => g.data.person === person).map((g) => g.data);
  return { person, summary: summarizeGoalsByStatus(personGoals) };
});

const base = import.meta.env.BASE_URL;
---

<Base title="Stats">
  <h1>Stats</h1>
  <ul class="person-summaries">
    {
      summaries.map(({ person, summary }) => (
        <li>
          <a href={`${base}${person}/goals`}>{person}</a>
          <span class="goal-summary">{summary}</span>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .person-summaries {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .person-summaries li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.75rem 1rem;
  }
  .goal-summary {
    color: var(--text-dim);
    font-size: 0.9rem;
  }
</style>
