---
import { Icon } from 'astro-icon/components';
import { REPO_URL } from '../lib/github.js';

interface Props {
  title: string;
}
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · grind-log</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={base}>grind-log</a>
      <nav>
        <a href={base}>Dashboard</a>
        <a href={`${base}guide`}>Guide</a>
        <a href={`${base}onboarding`}>Onboarding</a>
        <a href={`${base}stats`}>Stats</a>
        <a href={REPO_URL} target="_blank" rel="noopener" class="nav-github">
          <Icon name="lucide:github" class="nav-github-icon" aria-hidden="true" />
          GitHub
        </a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0f1115;
    --surface: #171a21;
    --border: #2a2e37;
    --text: #e6e8eb;
    --text-dim: #9aa1ab;
    --accent: #6ea8fe;
    --excused: #d29922;
    --missed-border: #f85149;
    --not-scheduled: #20232b;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    font-family:
      -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.5;
  }
  a {
    color: var(--accent);
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 1rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    white-space: nowrap;
    border: 1px solid transparent;
    cursor: pointer;
  }
  .btn--primary {
    background: var(--accent);
    color: #0b0d11;
  }
  .btn--primary:hover {
    text-decoration: none;
    filter: brightness(1.08);
  }
  .btn--secondary {
    background: transparent;
    border-color: var(--border);
    color: var(--text);
  }
  .btn--secondary:hover {
    text-decoration: none;
    border-color: var(--accent);
  }
  .icon-btn {
    width: 16px;
    height: 16px;
  }
  .icon-inline {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    vertical-align: -1px;
  }
  .section-heading {
    font-size: 1.05rem;
    margin: 0 0 0.9rem;
  }
  .panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.25rem;
  }
  .panel-empty,
  .panel-copy {
    color: var(--text-dim);
    font-size: 0.9rem;
    margin: 0 0 0.75rem;
  }
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .brand {
    font-weight: 700;
    color: var(--text);
  }
  nav {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .nav-github {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .nav-github-icon {
    width: 15px;
    height: 15px;
  }
  main {
    max-width: 1180px;
    margin: 0 auto;
    padding: 1.5rem;
  }
</style>
