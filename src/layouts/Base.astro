---
interface Props {
  title: string;
}
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · grind-log</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={base}>grind-log</a>
      <nav>
        <a href={base}>Feed</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0f1115;
    --surface: #171a21;
    --border: #2a2e37;
    --text: #e6e8eb;
    --text-dim: #9aa1ab;
    --accent: #6ea8fe;
    --excused: #d29922;
    --missed-border: #f85149;
    --not-scheduled: #20232b;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    font-family:
      -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.5;
  }
  a {
    color: var(--accent);
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .brand {
    font-weight: 700;
    color: var(--text);
  }
  nav {
    display: flex;
    gap: 1rem;
  }
  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 1.5rem;
  }
</style>
